<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Share - {% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link href="https://bootswatch.com/5/lumen/bootstrap.min.css" rel="stylesheet">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        {% endblock %}

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    
    <body>
        <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{path('app_accueil')}}">Share</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarColor01">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                <a class="nav-link active" href="{{path('app_accueil')}}">Accueil
                    <span class="visually-hidden">(current)</span>
                </a>
                </li>
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <li class="nav-item">
                <a class="nav-link" href="{{path('app_profil')}}">Mon Profil</a>
                </li>
                {%endif %}
                <li class="nav-item">
                <a class="nav-link" href="{{path('app_contact')}}">Contact</a>
                </li>
                <li class="nav-item">
                <a class="nav-link" href="{{path('app_apropos')}}">A propos</a>
                </li>
                <li class="nav-item">
                <a class="nav-link" href="{{path('app_ml')}}">Mention légales</a>
                </li>
                <li>
                    <a class="nav-link" href="{{path('app_deposer')}}">Déposer un fichier</a>
                </li>
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Gestion</a>
                    <div class="dropdown-menu">
                        <a class="dropdown-item" href="{{path('app_categorie_ajouter')}}">Ajout de catégorie</a>
                        <a class="dropdown-item" href="{{ path('app_categories') }}">Liste des catégories</a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="#">Separated link</a>
                    </div>
                </li>
                {%endif %} 

                {# Avoir une page accessible que par l'admin pour voir la liste de l'ensemble des utilisateurs #}

                {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Gestion ADMIN</a>
                    <div class="dropdown-menu">
                        <a class="dropdown-item" href="{{path('app_users')}}">Liste des inscriptions</a>
                    </div>
                </li>  

                {% endif %}
            </ul>
            <form class="d-flex">
                <input class="form-control me-sm-2" type="search" placeholder="Search">
                <button class="btn btn-secondary my-2 my-sm-0" type="submit">Search</button>
            </form>
            {# Dans la navbar on ajoute le fait de pouvoir se connecter s'inscrire et se déconnecter si on l'est déja #}
            <ul class="navbar-nav me-auto">
                {% if not is_granted('IS_AUTHENTICATED_FULLY') %}  {#Permet de vérifier si il n'est pas connecter #}
                    <li class="nav-item"><a class="nav-link" href="{{path('app_login')}}">Se connecter</a></li>     
                    <li class="nav-item"><a class="nav-link" href="{{path('app_register')}}">S'inscrire</a></li>
                {% else %}  {#Sinon si il est connecter afficher son mail avec la possibilité de se logout #}
                    {% if is_granted('ROLE_MOD') or is_granted('ROLE_ADMIN') %}
                    <li class="nav-item"><a class="nav-link" href="{{path('app_liste_contacts')}}">Liste des contacts</a></li>
                    {% endif %}
                    <li class="nav-item"><a class="nav-link" href="{{path('app_logout')}}">{{app.user.email }} <i class="bi bi-box-arrow-right"></i></a></li>
                {% endif %}
            </ul>
            </div>
        </div>
        </nav>

        {% for message in app.flashes('notice') %}
        <div class="alert alert-warning text-center mt-4 mb-4" role="alert">
            <h2>{{message}}</h2>
        </div>
        {% endfor %}


        {% block body %}
        
        {% endblock %}
    </body>
</html>
