{% extends 'base.html.twig' %}

{% block title %}{{parent()}}Profil{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="text-center text-primary mt-4 pt-4 display-1 fw-bold">Bienvenue {{user.prenom }} {{user.nom }}</h1>
        <div class="row justify-content-center">
            <div class="col-12 col-md-6 bg-white p-4 m-0 text-primary">
                {%if('ROLE_MOD' in user.roles) %}
                    <h3 class="text-center">Role : Modérateur</h3>   
                {% elseif 'ROLE_ADMIN' in user.roles %}
                    <h3 class="text-center">Role : Admin</h3>
                {%else %}
                    <h3 class="text-center">Role : Utilisateur</h3>
                {%endif %}

                <h3 class="text-center">Date d'inscription le : {{ user.dateInscription | date("d-m-Y à H:i") }}</h3>
        </div>
    </div>
</div>
{% endblock %}
