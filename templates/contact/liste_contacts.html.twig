{% extends 'base.html.twig' %}

{% block title %}{{parent()}}Liste Contacts{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="text-center text-primary mt-4 pt-4 display-1 fw-bold">Liste des contacts</h1>

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 bg-white p-4 m-0 text-primary">
            <div class="table-resposive">
                <table class="table table-hover">
            <thead>
                <tr>
                <th scope="col">Nom</th>
                <th scope="col">Sujet</th>
                <th scope="col">Email</th>
                <th scope="col">Date</th>
                </tr>
            </thead>
            <tbody>
                {%for contact in contacts | sort((a,b)=>b.dateEnvoi<=>a.dateEnvoi)%}        {# Si b est supérieur à la premiére date il inverse #}
                <tr class="{{cycle(['table-primary','table-secondary'],loop.index0)}}"> {#Pour faire une ligne bleu une grise ...#}
                <td>{{contact.Nom | capitalize}}</td>    {#ce qui correspond à notre entité contact.php#}
                <td>{{contact.sujet | capitalize}}</td>
                <td>{{contact.email | lower}}</td>
                <td>{{contact.dateEnvoi | date("d-m-Y à H:i:s")}}</td>
                </tr>
                {% endfor %}
            </tbody>
            </table>
            </div>
        </div>
    </div>
</div>

{% endblock %}